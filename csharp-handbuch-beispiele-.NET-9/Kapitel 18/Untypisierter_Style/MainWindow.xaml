<Window x:Class="Untypisierter_Style.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Untypisierter_Style"
        mc:Ignorable="d"
        Title="MainWindow" Height="200" Width="400">
    <Window.Resources>
        <Style x:Key="btnStyle">
            <Setter Property="Button.Height" Value="35" />
            <Setter Property="Button.FontSize" Value="18" />
            <Setter Property="Button.Foreground" Value="White" />
            <Setter Property="Button.Margin" Value="5" />
            <Setter Property="Button.Background">
                <Setter.Value>
                    <LinearGradientBrush>
                        <GradientStop Offset="0.0" Color="#101010" />
                        <GradientStop Offset="1.0" Color="#AAAAAA" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>
    <StackPanel>
        <Button Style="{StaticResource btnStyle}" Content="Button1" />
        <Button Style="{StaticResource btnStyle}" Content="Button2" />
        <Button Style="{StaticResource btnStyle}" Content="Button3" />
    </StackPanel>
</Window>
