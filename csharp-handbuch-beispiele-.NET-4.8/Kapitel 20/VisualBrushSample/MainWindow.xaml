<Window x:Class="VisualBrushSample.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VisualBrushSample"
        mc:Ignorable="d"
       Title="VisualBrushSample" Height="300" Width="400">
    <Grid>
        <StackPanel>
            <StackPanel.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Offset="0.0" Color="Black" />
                    <GradientStop Offset="1.0" Color="Gray" />
                </LinearGradientBrush>
            </StackPanel.Background>
            <Image Margin="0,10,0,0" Source="Jeepney.jpg" Name="Jeepney" Height="150" Width="200" Stretch="Uniform" />
            <Rectangle Height="80">
                <Rectangle.Fill>
                    <VisualBrush Visual="{Binding ElementName=Jeepney}" Stretch="None" Opacity="0.6">
                        <VisualBrush.RelativeTransform>
                            <TransformGroup>
                                <ScaleTransform ScaleY="-1.5" />
                                <TranslateTransform Y="1" />
                                <SkewTransform AngleX="-12" />
                            </TransformGroup>
                        </VisualBrush.RelativeTransform>
                    </VisualBrush>
                </Rectangle.Fill>
            </Rectangle>
        </StackPanel>
    </Grid>
</Window>
