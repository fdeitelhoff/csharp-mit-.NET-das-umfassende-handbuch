<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiBeispiele.LoginPage"
             xmlns:vm="clr-namespace:MauiBeispiele">

    <ContentPage.BindingContext>
        <vm:LoginViewModel />
    </ContentPage.BindingContext>

    <VerticalStackLayout Padding="30" Spacing="20">
        <Label Text="Anmeldung" FontSize="28" HorizontalOptions="Center" />
        <Entry Placeholder="Benutzername" Text="{Binding Benutzername}" />
        <Button Text="Login" Command="{Binding LoginCommand}" />
        <Label Text="{Binding Begrüßung}" FontAttributes="Italic" TextColor="DarkGreen" />
    </VerticalStackLayout>
</ContentPage>
