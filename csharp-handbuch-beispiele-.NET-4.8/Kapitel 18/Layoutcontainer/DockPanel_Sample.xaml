<Window x:Class="Layoutcontainer.DockPanel_Sample"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Layoutcontainer"
        mc:Ignorable="d"
        Title="DockPanel_Sample" Height="300" Width="500">
    <DockPanel>
        <Button DockPanel.Dock="Top">Button 1</Button>
        <Button DockPanel.Dock="Left">Button 2</Button>
        <Button DockPanel.Dock="Left">Button 3</Button>
        <Button DockPanel.Dock="Right">Button 4</Button>
        <Button DockPanel.Dock="Bottom">Button 5</Button>
        <Button DockPanel.Dock="Bottom">Button 6</Button>
    </DockPanel>
</Window>
